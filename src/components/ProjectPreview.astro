---
interface Props {
  tags: string[];
  title: string;
  summary: string;
  projectHref: string;
  blogHref: string;
  liveHref?: string;
  githubHref: string;
}

const { tags, title, summary, projectHref, liveHref, githubHref } = Astro.props;

const isExternalProject = projectHref.startsWith("http");
---

<article class="project-card relative">
  <div class="card-inner relative z-10 bg-[#0a0a0a] border border-white/15 rounded-sm p-6 transition-all duration-300 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:gap-10">

      <!-- Left: title + tags -->
      <div class="sm:w-[38%] flex flex-col justify-between gap-5 shrink-0">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-heading text-xl font-medium leading-snug text-white">
            {title}
          </h3>
          <a
            href={githubHref}
            class="shrink-0 w-5 h-5 text-white/30 hover:text-white transition-colors mt-1"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub repository"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor">
              <path d="M208.31,75.68A59.78,59.78,0,0,0,202.93,28,8,8,0,0,0,196,24a59.75,59.75,0,0,0-48,24H124A59.75,59.75,0,0,0,76,24a8,8,0,0,0-6.93,4,59.78,59.78,0,0,0-5.38,47.68A58.14,58.14,0,0,0,56,104v8a56.06,56.06,0,0,0,48.44,55.47A39.8,39.8,0,0,0,96,192v8H72a24,24,0,0,1-24-24A40,40,0,0,0,8,136a8,8,0,0,0,0,16,24,24,0,0,1,24,24,40,40,0,0,0,40,40H96v16a8,8,0,0,0,16,0V192a24,24,0,0,1,48,0v40a8,8,0,0,0,16,0V192a39.8,39.8,0,0,0-8.44-24.53A56.06,56.06,0,0,0,216,112v-8A58.14,58.14,0,0,0,208.31,75.68ZM200,112a40,40,0,0,1-40,40H112a40,40,0,0,1-40-40v-8a41.74,41.74,0,0,1,6.9-22.48A8,8,0,0,0,80,73.83a43.81,43.81,0,0,1,.79-33.58,43.88,43.88,0,0,1,32.32,20.06A8,8,0,0,0,119.82,64h32.35a8,8,0,0,0,6.74-3.69,43.87,43.87,0,0,1,32.32-20.06A43.81,43.81,0,0,1,192,73.83a8.09,8.09,0,0,0,1,7.65A41.72,41.72,0,0,1,200,104Z"/>
            </svg>
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="font-body text-xs font-medium bg-white text-black px-2.5 py-1 rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Divider -->
      <div class="hidden sm:block w-px bg-white/10 self-stretch shrink-0"></div>

      <!-- Right: summary + links -->
      <div class="flex flex-col justify-between gap-4 mt-5 sm:mt-0 sm:flex-1">
        <p class="font-body text-sm text-white/60 leading-relaxed">
          {summary}
        </p>
        <div class="flex items-center gap-5">
          <a
            href={projectHref}
            class="font-body text-sm font-medium tracking-wide underline decoration-1 underline-offset-2 transition-opacity hover:opacity-60 text-white/50"
            target={isExternalProject ? "_blank" : undefined}
            rel={isExternalProject ? "noopener noreferrer" : undefined}
          >
            Read more &rarr;
          </a>
          {liveHref && (
            <a
              href={liveHref}
              class="inline-flex items-center gap-1 font-body text-sm font-medium tracking-wide transition-opacity hover:opacity-60 text-white/50"
              target="_blank"
              rel="noopener noreferrer"
            >
              Live link
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="w-3 h-3">
                <path d="M200,64V168a8,8,0,0,1-16,0V83.31L69.66,197.66a8,8,0,0,1-11.32-11.32L172.69,72H88a8,8,0,0,1,0-16H192A8,8,0,0,1,200,64Z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

    </div>
  </div>
</article>

<style>
  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: black;
    border-radius: 0.125rem;
    transform: translate(6px, 6px);
    transition: transform 0.3s ease;
  }

  .project-card:hover .card-inner {
    transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.08);
  }

  .project-card:hover::before {
    transform: translate(10px, 10px);
  }
</style>
