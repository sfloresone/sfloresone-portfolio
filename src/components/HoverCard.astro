---
interface Props {
  href: string;
  label: string;
  image?: string;
  siteName: string;
  lines: [string, string];
  external?: boolean;
}

const { href, label, image, siteName, lines, external = true } = Astro.props;
---

<span class="hc-trigger">
  <a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
  >{label}</a><span class="hc-popup">
    <span class="hc-image-wrap">
      {image
        ? <img src={image} alt={siteName} class="hc-img" />
        : <span class="hc-placeholder">{siteName}</span>
      }
    </span>
    <span class="hc-body">
      <span class="hc-domain">{siteName}</span>
      <span class="hc-line1">{lines[0]}</span>
      <span class="hc-line2">{lines[1]}</span>
    </span>
  </span>
</span>

<style>
  .hc-trigger {
    position: relative;
    display: inline-block;
  }

  .hc-trigger a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: opacity 0.15s;
  }

  .hc-trigger a:hover {
    opacity: 0.7;
  }

  .hc-popup {
    display: block;
    position: fixed;
    width: 20rem;
    max-width: 80vw;
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.18s ease-out, transform 0.18s ease-out;
  }

  @media (min-width: 640px) {
    .hc-popup.is-visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  .hc-image-wrap {
    display: block;
    width: 100%;
    height: 8rem;
    background: #f5f5f5;
    overflow: hidden;
  }

  .hc-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .hc-placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
    color: #bbb;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hc-body {
    display: block;
    padding: 0.625rem 0.75rem;
  }

  .hc-domain {
    display: block;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #aaa;
    margin-bottom: 0.25rem;
  }

  .hc-line1 {
    display: -webkit-box;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.4;
    color: #000;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .hc-line2 {
    display: -webkit-box;
    font-size: 0.7rem;
    line-height: 1.4;
    color: #777;
    margin-top: 0.25rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
</style>

<script>
  function initHoverCards() {
    document.querySelectorAll<HTMLElement>(".hc-trigger").forEach((trigger) => {
      const popup = trigger.querySelector<HTMLElement>(".hc-popup");
      if (!popup) return;

      // Move popup to body to escape animation stacking contexts
      document.body.appendChild(popup);

      trigger.addEventListener("mouseenter", () => {
        const rect = trigger.getBoundingClientRect();
        const pw = popup.offsetWidth || 320;
        let left = rect.left;
        if (left + pw > window.innerWidth - 8) left = rect.right - pw;
        popup.style.left = left + "px";
        popup.style.top = (rect.bottom + 8) + "px";
        popup.classList.add("is-visible");
      });

      trigger.addEventListener("mouseleave", () => {
        popup.classList.remove("is-visible");
      });
    });
  }

  document.addEventListener("astro:page-load", initHoverCards);
  initHoverCards();
</script>
