---
import TechIcon from './TechIcon.astro';

interface Props { name: string; }
const { name } = Astro.props;
---
<span class="inline-flex items-center gap-2 font-body text-sm font-medium bg-white text-black px-3 py-1.5 rounded-sm">
  <TechIcon name={name} class="w-4 h-4 shrink-0" />
  {name}
</span>
