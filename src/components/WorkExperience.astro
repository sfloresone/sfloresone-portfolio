---
interface Role {
  title: string;
  type: string;
  period: string;
  bullets: string[];
  current?: boolean;
}

interface Props {
  company: string;
  logo: string;
  url: string;
  location: string;
  totalPeriod: string;
  tags?: string[];
  roles: Role[];
}

const { company, logo, url, totalPeriod, tags, roles } = Astro.props;
---

<div class="flex gap-6">
  <div class="shrink-0 w-10 pt-1">
    <a href={url} target="_blank" rel="noopener noreferrer">
      <img src={logo} alt={`${company} logo`} class="w-9 h-9 object-contain" />
    </a>
  </div>

  <div class="flex-1 min-w-0">
    <!-- Company header -->
    <div class="flex items-baseline justify-between gap-4">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-heading text-xl font-medium text-black hover:opacity-60 transition-opacity"
      >
        {company}
      </a>
      <span class="font-body text-sm text-neutral-400 shrink-0 tabular-nums">{totalPeriod}</span>
    </div>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-3">
        {tags.map((tag) => (
          <span class="font-body text-xs font-medium bg-black text-white px-2.5 py-1 rounded-sm">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Roles -->
    <div class="mt-6 flex flex-col gap-6">
      {roles.map((role) => (
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <span class="font-body text-base font-semibold text-black">
              {role.title}
            </span>
            <span class="font-body text-sm text-neutral-400 shrink-0 tabular-nums">{role.period}</span>
          </div>
          <span class="font-body text-xs uppercase tracking-[0.15em] text-neutral-400 mt-0.5 block">
            {role.type}
          </span>
          <ul class="mt-3 flex flex-col gap-2">
            {role.bullets.map((bullet) => (
              <li class="font-body text-sm text-neutral-600 leading-relaxed flex gap-2.5 items-baseline">
                <span class="text-neutral-400 shrink-0">·</span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</div>
