---
import TechIcon from "./TechIcon.astro";
import Tooltip from "./Tooltip.astro";

interface Role {
  title: string;
  type: string;
  period: string;
  description: string;
  current?: boolean;
  tags?: string[];
}

interface Props {
  company: string;
  url: string;
  location: string;
  roles: Role[];
}

const { company, url, location, roles } = Astro.props;
---

<div class="relative">
  <!-- Vertical line -->
  <div class="absolute left-[5px] top-[10px] bottom-3 w-px bg-neutral-200"></div>

  {roles.map((role) => (
    <div class="relative flex gap-7 pb-10 last:pb-0">
      <!-- Dot -->
      <div class="shrink-0 mt-[6px] z-10">
        {role.current ? (
          <div class="relative w-[11px] h-[11px]">
            <div class="dot-pulse absolute inset-0"></div>
            <div class="relative w-[11px] h-[11px] rounded-full bg-[#22c55e]"></div>
          </div>
        ) : (
          <div class="w-[11px] h-[11px] rounded-full bg-neutral-300"></div>
        )}
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0">
        <!-- Title row -->
        <div class="flex items-baseline justify-between gap-4">
          <div class="flex items-baseline gap-2 flex-wrap">
            <span class="font-body text-base font-semibold text-[#111111]">{role.title}</span>
            <span class="text-neutral-300 select-none">·</span>
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body text-base text-neutral-500 hover:text-black transition-colors"
            >{company}</a>
          </div>
          <span class="font-body text-sm font-medium tabular-nums shrink-0 text-[#1a1a1a]">{role.period}</span>
        </div>

        <!-- Location + type -->
        <p class="font-body text-sm text-neutral-500 mt-0.5">{location}, {role.type}</p>

        <!-- Description -->
        <p class="font-body text-base text-[#3a3a3a] leading-[1.8] mt-4" set:html={role.description} />

        <!-- Tech icons -->
        {role.tags && role.tags.length > 0 && (
          <div class="flex items-center gap-4 mt-5">
            {role.tags.map((tag) => (
              <Tooltip label={tag} variant="dark">
                <TechIcon name={tag} class="w-5 h-5" />
              </Tooltip>
            ))}
          </div>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  p :global(strong) {
    font-weight: 600;
    color: #171717;
  }
</style>
