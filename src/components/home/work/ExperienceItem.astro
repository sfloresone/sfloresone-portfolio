---
import type { WorkEntry } from "../../../data/site";
import IconTile from "../IconTile.astro";
import ExperiencePositionItem from "./ExperiencePositionItem.astro";

interface Props {
  work: WorkEntry;
  index: number;
}

const { work, index } = Astro.props;
---

<section class="max-w-[68ch]" aria-labelledby={`work-company-${index}`}>
  <header class="flex flex-wrap items-center justify-between gap-x-5 gap-y-2">
    <div class="flex min-w-0 items-center gap-[0.7rem]">
      <IconTile
        src={work.logo}
        class="size-[1.85rem] overflow-hidden rounded-full bg-[color-mix(in_srgb,#ffffff_6%,var(--color-surface))]"
        imgClass="opacity-88"
      />
      <h2 class="min-w-0 text-[1rem] leading-[1.3] font-semibold text-ink" id={`work-company-${index}`}>
        <a
          class="transition-[color] duration-300 ease-linear hover:text-link"
          href={work.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {work.company}
        </a>
      </h2>
    </div>
    <p class="text-right text-[0.82rem] leading-[1.35] text-muted">
      {work.location} ({work.arrangement})
    </p>
  </header>

  <ul class="mt-[1.15rem] flex flex-col gap-5 rail-line [--rail-x:0.75rem]">
    {work.roles.map((role) => <ExperiencePositionItem role={role} />)}
  </ul>
</section>
