---
import IconTile from "../IconTile.astro";
import TimelineItem from "../TimelineItem.astro";
import type { Role } from "../../../data/site";
import { formatRoleRange, formatTenure } from "../../../lib/tenure";

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<TimelineItem
  as="li"
  tile="1.5rem"
  gap="0.75rem"
  railEnd="last"
  title={role.title}
  meta={[role.type, formatRoleRange(role.start, role.end), formatTenure(role.start, role.end)]}
  bullets={role.bullets}
  tags={role.tags}
  tagsLabel={`Stack for ${role.title}`}
>
  <IconTile
    slot="tile"
    class="size-(--tile) rounded-md border border-muted/25 bg-[color-mix(in_srgb,#ffffff_5%,var(--color-surface))] text-muted"
  >
    <svg
      class="block size-[0.9rem]"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M5.5 4.25 2.75 8 5.5 11.75M10.5 4.25 13.25 8 10.5 11.75"></path>
    </svg>
  </IconTile>
</TimelineItem>
