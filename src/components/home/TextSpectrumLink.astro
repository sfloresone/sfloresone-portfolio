---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="group pane-link" href={href}>
  <span class="relative inline-grid">
    <span
      class="col-start-1 row-start-1 text-transparent underline decoration-underline underline-offset-[3px] group-hover:decoration-ink group-focus-visible:decoration-ink"
    >
      {label}
    </span>
    <span
      class="col-start-1 row-start-1 bg-[linear-gradient(90deg,#b9a8ff_0%,#9dcaff_25%,#a5e8d3_50%,#f0dfa0_75%,#f0afc3_100%)] bg-clip-text text-transparent opacity-85 transition-opacity duration-300 ease-linear group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none"
      aria-hidden="true"
    >
      {label}
    </span>
  </span>
</a>
