---
import { sectionById, type SectionId } from "../../data/site";

interface Props {
  id: SectionId;
}

const { id } = Astro.props;

const section = sectionById(id);
---

<article class="pane" data-pane={id} aria-labelledby={`pane-title-${id}`}>
  <header class="pane-head">
    <h1 class="pane-title" id={`pane-title-${id}`} tabindex="-1">{section.label}</h1>
    <a href="/" class="pane-close" data-pane-close aria-label={`Close ${section.label}`}>
      <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3.5 3.5l5 5M8.5 3.5l-5 5"></path></svg>
    </a>
  </header>
  <slot />
</article>
