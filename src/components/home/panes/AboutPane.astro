---
import Pane from "../Pane.astro";
import IconTile from "../IconTile.astro";
import SectionLabel from "../SectionLabel.astro";
import Separator from "../Separator.astro";
import Tag from "../Tag.astro";
import TimelineItem from "../TimelineItem.astro";
import { education, skills, story } from "../../../data/site";

const capabilities = [
  { label: "Languages", items: skills.languages },
  { label: "Frontend", items: skills.frontend },
  { label: "Backend & Data", items: skills.backendData },
  { label: "Workflow & AI", items: skills.workflowAi },
  { label: "Platform", items: skills.platform },
];
---

<Pane id="about">
  <section class="max-w-[68ch]">
    <p>
      Computer Science student at
      <a class="pane-link" href="https://www.upm.es/" target="_blank" rel="noopener noreferrer"
        >Universidad Politécnica de Madrid</a
      >, focused on backend systems, infrastructure, and useful software.
    </p>
    <p class="mt-4">
      Also, I love building products and care a lot about the aesthetics of  
    </p>
    <p class="mt-4">
      <a class="pane-link" href={story.href}>{story.label}</a>
    </p>
  </section>

  <section class="mt-12.5 max-w-[68ch]" aria-labelledby="about-stack">
    <SectionLabel id="about-stack">Stack</SectionLabel>
    <div
      class="relative flex flex-col before:pointer-events-none before:absolute before:inset-y-0 before:left-[9.75rem] before:z-0 before:w-0 before:border-l before:border-dashed before:border-line"
    >
      <Separator />
      {
        capabilities.map((capability) => (
          <>
            <div class="relative z-1 grid min-w-0 grid-cols-[9.75rem_minmax(0,1fr)] items-start gap-x-4 py-[0.95rem]">
              <h3 class="pr-3 text-[0.75rem] leading-[1.4] font-medium tracking-[0.06em] text-muted uppercase">
                {capability.label}
              </h3>
              <ul class="flex flex-wrap items-center gap-[0.4rem]">
                {capability.items.map((name) => (
                  <li>
                    <Tag name={name} />
                  </li>
                ))}
              </ul>
            </div>
            <Separator />
          </>
        ))
      }
    </div>
  </section>

  <Separator variant="diagonal" class="mt-0 mb-7.5" />

  <section class="max-w-[68ch]" aria-labelledby="about-education">
    <SectionLabel id="about-education">Education</SectionLabel>

    {
      education.map((entry, index) => (
        <>
          {index > 0 && <Separator class="my-6.25" />}
          <TimelineItem
            as="article"
            class:list={{ "mt-[0.85rem]": index === 0 }}
            aria-labelledby={`education-institution-${index}`}
            tile="2.6rem"
            gap="0.85rem"
            align="center"
            ownRail
            title={`${entry.institution} - ${entry.abbreviation}`}
            titleId={`education-institution-${index}`}
            meta={[entry.educationType, entry.period]}
            bullets={entry.bullets}
            bulletClass="marker:text-[length:0.85em]"
            tags={entry.tags}
            tagVariant="muted"
            tagsLabel={`Topics studied at ${entry.institution}`}
          >
            <IconTile slot="tile" src={entry.logo} class="size-(--tile)" imgClass="opacity-92" />
          </TimelineItem>
        </>
      ))
    }
  </section>
</Pane>
