---
import Pane from "../Pane.astro";
import Disclosure from "../Disclosure.astro";
import Separator from "../Separator.astro";
import TechChip from "../TechChip.astro";
import { education, skills } from "../../../data/site";

const capabilities = [
  { label: "Languages", items: skills.languages },
  { label: "Frontend", items: skills.frontend },
  { label: "Backend & Data", items: skills.backendData },
  { label: "Workflow & AI", items: skills.workflowAi },
  { label: "Platform", items: skills.platform },
];
---

<Pane id="about">
  <section class="pane-block pane-intro">
    <p>
      Computer Science student at
      <a href="https://www.upm.es/" target="_blank" rel="noopener noreferrer">Universidad Politécnica de Madrid</a>,
      focused on backend systems, infrastructure, and useful software.
    </p>
  </section>

  <section class="pane-block" aria-labelledby="about-stack">
    <h2 class="pane-label" id="about-stack">Stack</h2>
    <div class="pane-stack-list">
      <Separator />
      {
        capabilities.map((capability) => (
          <>
            <div class="pane-stack-row">
              <h3 class="pane-stack-label">{capability.label}</h3>
              <ul class="pane-stack-icons">
                {capability.items.map((name) => (
                  <li>
                    <TechChip name={name} />
                  </li>
                ))}
              </ul>
            </div>
            <Separator />
          </>
        ))
      }
    </div>
  </section>

  <Separator />

  <section class="pane-block pane-education" aria-labelledby="about-education">
    <h2 class="pane-label" id="about-education">Education</h2>

    {
      education.map((entry, index) => (
        <>
          {index > 0 && <Separator />}
          <article class="work-company education-entry" aria-labelledby={`education-institution-${index}`}>
            <header class="work-company-header">
              <div class="work-company-brand">
                <div class="work-company-logo">
                  <img src={entry.logo} alt="" loading="lazy" decoding="async" />
                </div>
                <div class="education-institution-line">
                  <h3 class="work-company-name" id={`education-institution-${index}`}>
                    {entry.institution}
                  </h3>
                  <span class="education-abbreviation">{entry.abbreviation}</span>
                </div>
              </div>
              <p class="work-company-place">{entry.period}</p>
            </header>

            <ul class="work-roles">
              <li class="work-role">
                <div class="work-role-icon" aria-hidden="true">
                  <svg viewBox="0 0 16 16" class="work-role-icon-svg">
                    <path
                      d="M1.5 6.5 8 3.5l6.5 3-6.5 3-6.5-3Z"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M4 8.2v2.4c0 .7 1.8 1.6 4 1.6s4-.9 4-1.6V8.2"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M14.5 6.5v3.25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.3"
                      stroke-linecap="round"
                    />
                  </svg>
                </div>

                <div class="work-role-body">
                  <Disclosure class="work-role-disclosure">
                    <span slot="summary" class="work-role-summary">
                      <span class="work-role-title">{entry.studyName}</span>
                      <span class="work-role-meta">
                        <span>{entry.educationType}</span>
                        <span class="work-role-meta-sep" aria-hidden="true">|</span>
                        <span>{entry.period}</span>
                      </span>
                    </span>

                    <ul class="work-role-bullets">
                      {entry.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  </Disclosure>

                  <ul class="education-tags" aria-label={`Topics studied at ${entry.institution}`}>
                    {entry.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </div>
              </li>
            </ul>
          </article>
        </>
      ))
    }
  </section>
</Pane>
