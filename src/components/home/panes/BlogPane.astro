---
import { getCollection } from "astro:content";
import Pane from "../Pane.astro";
import { styleForCategory } from "../../../data/site";

const posts = (await getCollection("blog", ({ data }) => data.published)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const showCategories = new Set(posts.map((post) => post.data.category)).size > 1;
---

<Pane id="blog">
  <section class="pane-block">
    <ul class="pane-list">
      {
        posts.map((post) => (
          <li class="pane-entry">
            <div class="pane-entry-row">
              <a class="pane-strong" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
            </div>
            <p class="pane-muted">
              {showCategories && (
                <>
                  <span style={`color: ${styleForCategory(post.data.category).bar}`}>{post.data.category}</span>
                  <span aria-hidden="true"> · </span>
                </>
              )}
              <time datetime={post.data.date.toISOString().split("T")[0]}>
                {post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </time>
            </p>
            {post.data.description && <p>{post.data.description}</p>}
          </li>
        ))
      }
    </ul>
  </section>
</Pane>
