---
const navItems = [
  { label: "Home", href: "#home" },
  { label: "Projects", href: "#projects" },
  { label: "Writing/Thinking", href: "#writing" },
  { label: "About", href: "#about" },
];
---

<header class="max-w-[96ch] mx-auto px-6 py-8 animate-fade-in">
  <nav class="flex items-center gap-8">
    {
      navItems.map((item, index) => (
        <a
          href={item.href}
          class="font-sans text-base font-medium tracking-wide animate-fade-in-up hover:opacity-60 transition-opacity"
          style={`animation-delay: ${(index + 1) * 100}ms`}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>