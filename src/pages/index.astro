---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogPreview from "../components/BlogPreview.astro";
import ProjectPreview from "../components/ProjectPreview.astro";

const posts = await getCollection("blog");
const samplePosts = posts.map((p) => ({
  category: p.data.category,
  date: p.data.date,
  title: p.data.title,
  href: `/blog/${p.id}`,
}));

const projects = [
  {
    title: "sflores.one",
    tags: ["Astro", "Tailwind", "Cloudflare"],
    summary: "Mi rincón personal en la web. Este mismo portfolio, construido con Astro y Tailwind, desplegado en Cloudflare con scroll-snap y View Transitions.",
    projectHref: "/project/sflores-one",
    blogHref: "/blog/test-post",
    liveHref: "https://sflores.one",
    githubHref: "https://github.com/sfloresone/sfloresone-portfolio",
  },
  {
    title: "Chaski",
    tags: ["Rust", "CLI", "Queues"],
    summary: "Procesador de colas de mensajes en Rust con enfoque en rendimiento y zero-cost abstractions. Diseñado para alto throughput.",
    projectHref: "#",
    blogHref: "/blog/test-post",
    githubHref: "https://github.com/sfloresone/chaski",
  },
];

const socialLinks = [
  { label: "X", href: "https://x.com/sfloresone" },
  { label: "Github", href: "https://github.com/sfloresone" },
  { label: "LinkedIn", href: "https://linkedin.com/in/sfloresone" },
  { label: "Email", href: "mailto:hello@sflores.one" },
  { label: "CV", href: "/cv" },
];
---

<Layout title="Sergio Flores">
  <section id="home" class="min-h-screen bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 pt-32 pb-16">
      <h1 class="font-heading font-medium text-5xl sm:text-6xl lg:text-7xl mb-4 animate-fade-in-up">
        Sergio Flores
      </h1>

      <p class="font-heading uppercase tracking-widest text-sm sm:text-base mb-16 animate-fade-in-up delay-200 text-neutral-500 underline decoration-neutral-500 underline-offset-4 decoration-1">
        ENGINEERING &amp; PRODUCT
      </p>

      <p class="font-body text-lg sm:text-xl leading-relaxed animate-fade-in-up delay-300">
        Soy desarrollador de software especializado en construir experiencias
        digitales rápidas, accesibles y con atención al detalle. Me mueve
        crear proyectos donde el código no solo funciona, sino que se siente
        bien al usarlo. Este espacio es mi rincón personal para compartir
        trabajo, ideas y lo que voy aprendiendo en el camino.
      </p>

      <div class="flex justify-between items-center mt-16 text-base animate-fade-in-up delay-500">
        <div class="flex items-center gap-2 flex-wrap">
          {
            socialLinks.map((link, index) => (
              <>
                {link.label === "Email" ? (
                  <button
                    class="font-body font-medium tracking-wide animate-fade-in hover:opacity-60 transition-opacity border-none bg-transparent cursor-pointer p-0"
                    style={`animation-delay: ${500 + index * 100}ms`}
                    data-copy
                    data-email="hello@sflores.one"
                  >
                    <span class="copy-label">Email</span>
                    <span class="copy-check hidden">✓ Copied</span>
                  </button>
                ) : (
                  <a
                    href={link.href}
                    class="font-body font-medium tracking-wide animate-fade-in hover:opacity-60 transition-opacity"
                    style={`animation-delay: ${500 + index * 100}ms`}
                    target={link.label === "CV" ? undefined : "_blank"}
                    rel={link.label === "CV" ? undefined : "noopener noreferrer"}
                  >
                    {link.label}
                  </a>
                )}
                {index < socialLinks.length - 1 && (
                  <span class="opacity-40 select-none">·</span>
                )}
              </>
            ))
          }
        </div>

        <div class="font-bold animate-fade-in" style="animation-delay: 1000ms">
          Be crazy.
        </div>
      </div>
    </div>
  </section>

  <section
    id="projects"
    class="snap-start min-h-screen bg-black text-white flex items-center justify-center"
  >
    <div class="max-w-[85ch] mx-auto px-6 py-24 w-full">
      <h2 class="font-heading font-medium text-4xl mb-2">Projects</h2>
      <p class="font-body text-base text-neutral-400 italic mb-16">
        Things I&rsquo;ve built (or am still building).
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {projects.map((p) => (
          <ProjectPreview
            tags={p.tags}
            title={p.title}
            summary={p.summary}
            projectHref={p.projectHref}
            blogHref={p.blogHref}
            liveHref={p.liveHref}
            githubHref={p.githubHref}
          />
        ))}
      </div>
    </div>
  </section>

  <section
    id="writing"
    class="snap-start min-h-screen bg-white text-black flex items-center"
  >
    <div class="max-w-[85ch] mx-auto px-6 py-24 w-full">
      <h2 class="font-heading font-medium text-4xl mb-2">Brainwaves.</h2>
      <p class="font-body text-base text-neutral-500 italic mb-16">
        Ideas that didn&rsquo;t know where else to go.
      </p>
      <div class="grid gap-8">
        {samplePosts.map((post) => (
          <BlogPreview category={post.category} date={post.date} title={post.title} href={post.href} />
        ))}
      </div>
    </div>
  </section>

  <section
    id="about"
    class="snap-start min-h-screen bg-black text-white flex items-center justify-center"
  >
    <div class="max-w-[85ch] mx-auto px-6 py-24">
      <h2 class="font-heading font-medium text-4xl mb-4">About</h2>
      <p class="font-body text-lg">Coming soon.</p>
    </div>
  </section>

  <button
    id="back-to-top"
    class="fixed bottom-8 right-8 z-50 rounded-full w-10 h-10 flex items-center justify-center invisible opacity-0 transition-all duration-300 cursor-pointer shadow-sm bg-black/80 text-white border border-white/30 hover:bg-black"
    aria-label="Volver arriba"
  >
    ↑
  </button>
</Layout>

<script type="module">
  const hero = document.getElementById("home");
  const topBtn = document.getElementById("back-to-top");

  if (hero && topBtn) {
    const show = (visible = false) => {
      topBtn.classList.toggle("invisible", !visible);
      topBtn.classList.toggle("opacity-100", visible);
    };

    new IntersectionObserver(
      ([entry]) => show(!entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);

    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const sectionObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const isDark = entry.target.classList.contains("bg-black");
          topBtn.classList.toggle("invert", isDark);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", isDark ? "#000000" : "#ffffff");
        }
      }
    }, { threshold: 0.4 });

    document.querySelectorAll("section[id]").forEach(
      (s) => sectionObserver.observe(s)
    );
  }

  document.querySelectorAll("[data-copy]").forEach((el) => {
    el.addEventListener("click", async () => {
      const email = (el).getAttribute("data-email") ?? "";
      try {
        await navigator.clipboard.writeText(email);
        el.querySelector(".copy-label")?.classList.add("hidden");
        el.querySelector(".copy-check")?.classList.remove("hidden");
        setTimeout(() => {
          el.querySelector(".copy-check")?.classList.add("hidden");
          el.querySelector(".copy-label")?.classList.remove("hidden");
        }, 2500);
      } catch {
        const fallback = document.createElement("textarea");
        fallback.value = email;
        document.body.appendChild(fallback);
        fallback.select();
        document.execCommand("copy");
        document.body.removeChild(fallback);
      }
    });
  });
</script>