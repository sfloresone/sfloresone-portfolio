---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlogPreview from "../components/BlogPreview.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import HoverCard from "../components/HoverCard.astro";
import WorkExperience from "../components/WorkExperience.astro";
import { featuredProjects } from "../data/projects";
import { workExperiences } from "../data/work";
import { socialLinks } from "../data/social";

const posts = await getCollection("blog");
const samplePosts = posts.map((p) => ({
  category: p.data.category,
  date: p.data.date,
  title: p.data.title,
  href: `/blog/${p.id}`,
}));
---

<Layout title="Sergio Flores">
  <section id="home" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 pt-32 pb-24">
      <h1 data-reveal class="font-heading font-medium text-5xl sm:text-6xl lg:text-7xl mb-4">
        Sergio Flores
      </h1>

      <p data-reveal style="transition-delay:80ms" class="font-body uppercase tracking-[0.2em] text-xs sm:text-sm mb-16 text-neutral-500">
        Engineering · Product
      </p>

      <p data-reveal style="transition-delay:160ms" class="font-body text-base sm:text-lg leading-relaxed">
        Computer Science student at <HoverCard href="https://www.upm.es" label="Universidad Politécnica de Madrid." image="/previews/upm-banner.webp" siteName="upm.es" lines={["Universidad Politécnica de Madrid", "Escuela Técnica Superior de Ingeniería de Sistemas Informáticos"]} />
      </p>
      <p data-reveal style="transition-delay:220ms" class="font-body text-base sm:text-lg leading-relaxed mt-4">
        Methodical by nature — I care about how software is built as much as what it does.
      </p>
      <p data-reveal style="transition-delay:280ms" class="font-body text-base sm:text-lg leading-relaxed mt-4">
        I gravitate toward backend, systems architecture, and production-grade infrastructure.
        On the product side I think a lot about efficiency and accessibility — building tools
        that fit the people using them, as far from generic software as possible.
      </p>
      <p data-reveal style="transition-delay:340ms" class="font-body text-base sm:text-lg leading-relaxed mt-4">
        Currently building production-grade AI products at <HoverCard href="https://zaltor.com" label="Zaltor." image="/previews/banner-zaltor.jpg" siteName="zaltor.com" lines={["Zaltor — Software Distribution", "Servicios Gestionados, Ciberseguridad, Backup y MSP."]} />
      </p>

      <div data-reveal style="transition-delay:420ms" class="flex justify-between items-center mt-16 text-base">
        <div class="flex items-center gap-2 flex-wrap">
          {
            socialLinks.map((link, index) => (
              <>
                {link.label === "Email" ? (
                  <button
                    class="font-body font-medium tracking-wide hover:opacity-60 transition-opacity border-none bg-transparent cursor-pointer p-0"
                    data-copy
                    data-email="hello@sflores.one"
                  >
                    <span class="copy-label">Email</span>
                    <span class="copy-check hidden">✓ Copied</span>
                  </button>
                ) : (
                  <a
                    href={link.href}
                    class="font-body font-medium tracking-wide hover:opacity-60 transition-opacity"
                    target={link.label === "CV" ? undefined : "_blank"}
                    rel={link.label === "CV" ? undefined : "noopener noreferrer"}
                  >
                    {link.label}
                  </a>
                )}
                {index < socialLinks.length - 1 && (
                  <span class="opacity-40 select-none">·</span>
                )}
              </>
            ))
          }
        </div>

        <div class="font-bold">
          Be crazy.
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-2">Work</h2>
        <p class="font-body text-base text-neutral-500 italic mb-16">
          Where I&rsquo;ve spent my time.
        </p>
      </div>
      <div class="flex flex-col gap-16">
        {workExperiences.map((w, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <WorkExperience
              company={w.company}
              logo={w.logo}
              url={w.url}
              location={w.location}
              totalPeriod={w.totalPeriod}
              tags={w.tags}
              roles={w.roles}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-2">Projects</h2>
        <p class="font-body text-base text-neutral-500 italic mb-16">
          Things I&rsquo;ve built (or am still building).
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {featuredProjects.map((p, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <ProjectPreview
              tags={p.tags}
              title={p.title}
              summary={p.summary}
              projectHref={p.projectHref}
              blogHref={p.blogHref}
              liveHref={p.liveHref}
              githubHref={p.githubHref}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="writing" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-2">Brainwaves.</h2>
        <p class="font-body text-base text-neutral-500 italic mb-16">
          Ideas that didn&rsquo;t know where else to go.
        </p>
      </div>
      <div class="grid gap-8">
        {samplePosts.map((post, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <BlogPreview category={post.category} date={post.date} title={post.title} href={post.href} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="min-h-screen bg-black text-white flex items-start">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-8">About</h2>
        <p class="font-body text-lg leading-relaxed">
          Computer Science student at
          <HoverCard
            href="https://www.upm.es"
            label="Universidad Politécnica de Madrid."
            image="/previews/upm-banner.webp"
            siteName="upm.es"
            lines={["Universidad Politécnica de Madrid", "Escuela Técnica Superior de Ingeniería de Sistemas Informáticos"]}
          />
        </p>
        <p class="font-body text-lg leading-relaxed mt-5">
          Currently building two production-grade AI products at
          <HoverCard
            href="https://zaltor.com"
            label="Zaltor."
            image="/previews/banner-zaltor.jpg"
            siteName="zaltor.com"
            lines={["Zaltor — Software Distribution", "Servicios Gestionados, Ciberseguridad, Backup y MSP."]}
          />
        </p>
      </div>
    </div>
  </section>

  <button
    id="back-to-top"
    class="fixed bottom-8 right-8 z-[60] rounded-full w-10 h-10 flex items-center justify-center invisible opacity-0 transition-all duration-300 cursor-pointer shadow-sm bg-black/80 text-white border border-white/30 hover:bg-black"
    aria-label="Volver arriba"
  >
    ↑
  </button>
</Layout>

<script type="module">
  const hero = document.getElementById("home");
  const topBtn = document.getElementById("back-to-top");

  if (hero && topBtn) {
    const show = (visible = false) => {
      topBtn.classList.toggle("invisible", !visible);
      topBtn.classList.toggle("opacity-100", visible);
    };

    new IntersectionObserver(
      ([entry]) => show(!entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);

    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const sectionObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const isDark = entry.target.classList.contains("bg-black");
          topBtn.classList.toggle("invert", isDark);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", isDark ? "#000000" : "#ffffff");
        }
      }
    }, { threshold: 0.4 });

    document.querySelectorAll("section[id]").forEach(
      (s) => sectionObserver.observe(s)
    );
  }

  document.querySelectorAll("[data-copy]").forEach((el) => {
    el.addEventListener("click", async () => {
      const email = el.getAttribute("data-email") ?? "";
      try {
        await navigator.clipboard.writeText(email);
        el.querySelector(".copy-label")?.classList.add("hidden");
        el.querySelector(".copy-check")?.classList.remove("hidden");
        setTimeout(() => {
          el.querySelector(".copy-check")?.classList.add("hidden");
          el.querySelector(".copy-label")?.classList.remove("hidden");
        }, 2500);
      } catch {
        const fallback = document.createElement("textarea");
        fallback.value = email;
        document.body.appendChild(fallback);
        fallback.select();
        document.execCommand("copy");
        document.body.removeChild(fallback);
      }
    });
  });
</script>
