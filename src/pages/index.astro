---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ProjectPreview from "../components/ProjectPreview.astro";
import HoverCard from "../components/HoverCard.astro";
import WorkExperience from "../components/WorkExperience.astro";
import { featuredProjects } from "../data/projects";
import { workExperiences } from "../data/work";
import { socialLinks } from "../data/social";
import { skills } from "../data/about";
import TechIcon from "../components/TechIcon.astro";
import Tooltip from "../components/Tooltip.astro";
import mascotImage from "../assets/mascot-3d.png";

// Ordered by category so the row stays grouped: languages → frameworks → tools → databases.
// Excludes skills that have no icon in TechIcon (they'd leave an empty cell in the grid).
const iconless = new Set(["SQL", "Makefile"]);
const techStack = [
  ...skills.languages,
  ...skills.frameworks,
  ...skills.tools,
  ...skills.databases,
].filter((s) => !iconless.has(s));
---

<Layout title="Sergio Flores">
  <section id="home" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 pt-32 pb-24">
      <div data-reveal class="flex items-center justify-between mb-16">
        <h1 class="font-heading font-medium text-[36px] leading-[40px] sm:text-[44px] sm:leading-[47px] lg:text-[54px] lg:leading-[57px]">
          Sergio Flores
        </h1>
        <Image
          src={mascotImage}
          alt="Sergio Flores mascot"
          width={556}
          height={611}
          class="w-12 h-auto lg:w-14 shrink-0"
        />
      </div>

      <p data-reveal style="transition-delay:160ms" class="font-body text-base sm:text-lg leading-relaxed">
        Information Systems Engineering student at <HoverCard href="https://www.upm.es/" label="Universidad Politécnica de Madrid" image="/previews/upm-banner.webp" siteName="upm.es" lines={["UPM", "Escuela Técnica Superior de Ingeniería de Sistemas Informáticos"]} />
        and software engineering student at <HoverCard href="https://www.42madrid.com/" label="42 Madrid." image="/previews/42campus-madrid.webp" siteName="42madrid.com" lines={["42 Madrid", "Fundación Telefónica"]} />.
      </p>
      
      <p data-reveal style="transition-delay:220ms" class="font-body text-base sm:text-lg leading-relaxed mt-4">
        Methodical by nature — I care about how software is built as much as what it does.
      </p>
      <p data-reveal style="transition-delay:280ms" class="font-body text-base sm:text-lg leading-relaxed mt-4">
        I gravitate toward backend, systems architecture, and production-grade infrastructure.
        On the product side I think a lot about efficiency and accessibility — building tools
        that fit the people using them, as far from generic software as possible.
      </p>
      
      <p data-reveal style="transition-delay:340ms" class="font-body text-base sm:text-lg leading-relaxed mt-4">
        Currently building production-grade AI products at <HoverCard href="https://zaltor.com" label="Zaltor." image="/previews/banner-zaltor.jpg" siteName="zaltor.com" lines={["Zaltor — Software Distribution", "Servicios Gestionados, Ciberseguridad, Backup y MSP."]} />
      </p>

      <div data-reveal style="transition-delay:420ms" class="flex justify-between items-center mt-16">
        <div class="flex items-center gap-4">
          <!-- X / Twitter -->
          <a href="https://x.com/sfloresone" target="_blank" rel="noopener noreferrer" aria-label="X" class="text-black/60 hover:text-black transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <!-- GitHub -->
          <a href="https://github.com/sfloresone" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-black/60 hover:text-black transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          </a>
          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/sergiofloresmr" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-black/60 hover:text-black transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <!-- Email (copy to clipboard) -->
          <button
            class="text-black/60 hover:text-black transition-colors border-none bg-transparent cursor-pointer p-0 leading-none"
            data-copy
            data-email="hello@sflores.one"
            aria-label="Email"
          >
            <span class="copy-label">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
            </span>
            <span class="copy-check hidden text-xs font-body font-medium">✓</span>
          </button>
          <!-- CV 
          <a href="/cv" aria-label="CV" class="text-black/60 hover:text-black transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
          </a>
          -->
        </div>

        <button
          type="button"
          id="be-crazy"
          data-text="Be crazy."
          class="glitch-trigger font-bold text-base bg-transparent border-none p-0 cursor-pointer"
        >
          Be crazy.
        </button>
      </div>
    </div>
  </section>

  <section id="stack" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 py-24 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-2">Tech Stack</h2>
        <p class="font-body text-base text-neutral-500 italic mb-16">
          The tools I reach for (and the ones I tolerate).
        </p>
        <div class="grid gap-6 justify-start grid-cols-[repeat(auto-fill,40px)]">
          {techStack.map((s) => (
            <Tooltip label={s} variant="dark" class="w-10 justify-center">
              <TechIcon name={s} class="w-10 h-10" />
            </Tooltip>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-2">Work</h2>
        <p class="font-body text-base text-neutral-500 italic mb-16">
          Where I&rsquo;ve spent my time.
        </p>
      </div>
      <div class="flex flex-col gap-16">
        {workExperiences.map((w, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <WorkExperience
              company={w.company}
              url={w.url}
              location={w.location}
              roles={w.roles}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="bg-white text-black">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">
      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-2">Projects</h2>
        <p class="font-body text-base text-neutral-500 italic mb-16">
          Things I&rsquo;ve built (or am still building).
        </p>
      </div>
      <div class="grid gap-6">
        {featuredProjects.map((p, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`}>
            <ProjectPreview
              tags={p.tags}
              title={p.title}
              summary={p.summary}
              projectHref={p.projectHref}
              blogHref={p.blogHref}
              liveHref={p.liveHref}
              githubHref={p.githubHref}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="bg-black text-white">
    <div class="max-w-[85ch] mx-auto px-6 py-32 w-full">

      <div data-reveal>
        <h2 class="font-heading font-medium text-4xl mb-16">About</h2>
      </div>

      <!-- TODO: replace with real bio -->
      <div data-reveal>
        <p class="font-body text-base text-white/70 leading-[1.85]">
          I'll write something when I feel inspired :(.
        </p>
      </div>

    </div>
  </section>

  <button
    id="back-to-top"
    class="fixed bottom-8 right-8 z-[60] rounded-full w-10 h-10 flex items-center justify-center invisible opacity-0 transition-all duration-300 cursor-pointer shadow-sm bg-black/80 text-white border border-white/30 hover:bg-black"
    aria-label="Volver arriba"
  >
    ↑
  </button>

  <div id="crazy-shatter" aria-hidden="true"></div>
</Layout>

<script type="module">
  const hero = document.getElementById("home");
  const topBtn = document.getElementById("back-to-top");

  if (hero && topBtn) {
    const show = (visible = false) => {
      topBtn.classList.toggle("invisible", !visible);
      topBtn.classList.toggle("opacity-0", !visible);
      topBtn.classList.toggle("opacity-100", visible);
    };

    new IntersectionObserver(
      ([entry]) => show(!entry.isIntersecting),
      { threshold: 0 }
    ).observe(hero);

    topBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    const sectionObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          const isDark = entry.target.classList.contains("bg-black");
          topBtn.classList.toggle("invert", isDark);
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", isDark ? "#000000" : "#ffffff");
        }
      }
    }, { threshold: 0.4 });

    document.querySelectorAll("section[id]").forEach(
      (s) => sectionObserver.observe(s)
    );
  }

  const beCrazy = document.getElementById("be-crazy");
  if (beCrazy) {
    beCrazy.addEventListener("mouseenter", () => {
      beCrazy.classList.remove("glitch-active");
      // Force reflow so the animation restarts on rapid re-hovers.
      void beCrazy.offsetWidth;
      beCrazy.classList.add("glitch-active");
    });
    beCrazy.addEventListener("animationend", () => {
      beCrazy.classList.remove("glitch-active");
    });

    const shatter = document.getElementById("crazy-shatter");
    if (shatter) {
      beCrazy.addEventListener("click", () => {
        const rect = beCrazy.getBoundingClientRect();
        const originX = rect.left + rect.width / 2;
        const originY = rect.top + rect.height / 2;
        const pieceCount = 16;

        for (let i = 0; i < pieceCount; i++) {
          const piece = document.createElement("span");
          piece.className = "shatter-piece";

          const angle = (Math.PI * 2 * i) / pieceCount + (Math.random() - 0.5) * 0.6;
          const dist = 70 + Math.random() * 150;
          const dx = Math.cos(angle) * dist;
          const dy = Math.sin(angle) * dist * 0.7 + 20;
          const rot = (Math.random() - 0.5) * 720;
          const isLine = i % 2 === 0;
          const size = isLine ? 16 + Math.random() * 18 : 4 + Math.random() * 5;

          piece.style.setProperty("--dx", `${dx}px`);
          piece.style.setProperty("--dy", `${dy}px`);
          piece.style.setProperty("--rot", `${rot}deg`);
          piece.style.animationDelay = `${Math.random() * 60}ms`;
          piece.style.left = `${originX}px`;
          piece.style.top = `${originY}px`;
          piece.style.width = `${size}px`;
          piece.style.height = isLine ? "2px" : `${size}px`;
          piece.style.background = i % 5 === 0 ? "#fff" : "#000";
          piece.style.border = i % 5 === 0 ? "1px solid #000" : "none";

          shatter.appendChild(piece);
          piece.addEventListener("animationend", () => piece.remove(), { once: true });
        }
      });
    }
  }

  document.querySelectorAll("[data-copy]").forEach((el) => {
    el.addEventListener("click", async () => {
      const email = el.getAttribute("data-email") ?? "";
      try {
        await navigator.clipboard.writeText(email);
        el.querySelector(".copy-label")?.classList.add("hidden");
        el.querySelector(".copy-check")?.classList.remove("hidden");
        setTimeout(() => {
          el.querySelector(".copy-check")?.classList.add("hidden");
          el.querySelector(".copy-label")?.classList.remove("hidden");
        }, 2500);
      } catch {
        const fallback = document.createElement("textarea");
        fallback.value = email;
        document.body.appendChild(fallback);
        fallback.select();
        document.execCommand("copy");
        document.body.removeChild(fallback);
      }
    });
  });
</script>
